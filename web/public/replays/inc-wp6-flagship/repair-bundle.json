      ],
      "kind": "CODE_PATCH",
      "path": "pipeline/normalize.py.patch"
    },
    {
      "artifact_id": "repair-artifact:a3d58e09c2d7d243",
      "content": "from pipeline.normalize import UnitContractError, normalize_tg\n\n\ndef test_kelvin_and_celsius_normalize_to_the_same_scientific_value() -> None:\n    assert normalize_tg(373.15, \"K\") == 100.0\n    assert normalize_tg(100.0, \"degC\") == 100.0\n\n\ndef test_unknown_unit_fails_closed() -> None:\n    try:\n        normalize_tg(100.0, \"degF\")\n    except UnitContractError:\n        return\n    raise AssertionError(\"unknown units must not be silently accepted\")\n",
      "content_sha256": "3da4643a25c830e5400a63816cdef9f7c132ee1c7f130789f7f57412dd7b0d62",
      "description": "Unit contract and fail-closed unknown-unit tests.",
      "evidence_ids": [
        "field-impact:bb47513135e033a4",
        "upstream-lineage:94ee77e7deccd454",
        "unit-firmware-contract:711d085fe8869ed0",
        "datahub-live-receipt:fa0b942ca360c2ce"
      ],
      "kind": "CONTRACT_TEST",
      "path": "tests/test_unit_contract.py"
    },
    {
      "artifact_id": "repair-artifact:222c42a97be3e01e",
      "content": "from pipeline.normalize import normalize_tg\n\n\ndef _rank(rows: list[tuple[str, float]]) -> dict[str, int]:\n    ordered = sorted(rows, key=lambda item: (-item[1], item[0]))\n    return {candidate: rank for rank, (candidate, _) in enumerate(ordered, 1)}\n\n\ndef test_candidate_ranking_returns_to_trusted_baseline() -> None:\n    # Seventeen candidates are scientifically above P-204 and two are below it.\n    trusted = [(f\"P-HIGH-{index:02d}\", 118.0 - index) for index in range(17)]\n    trusted += [(\"P-204\", 100.0), (\"P-LOW-01\", 99.0), (\"P-LOW-02\", 98.0)]\n    contaminated = [\n        (candidate, value + 273.15 if candidate == \"P-204\" else value)\n        for candidate, value in trusted\n    ]\n    repaired = [\n        (\n            candidate,\n            normalize_tg(value, \"K\" if candidate == \"P-204\" else \"degC\"),\n        )\n        for candidate, value in contaminated\n    ]\n\n    assert _rank(contaminated)[\"P-204\"] == 1\n    assert _rank(repaired)[\"P-204\"] == 18\n",
      "content_sha256": "05135dfa4063d165b92007bf49dc6c0ff993fc390ac5bbfd68d75dc21495e1f9",
      "description": "Counterfactual P-204 ranking restoration check.",
