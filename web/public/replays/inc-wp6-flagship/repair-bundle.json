      "artifact_id": "repair-artifact:dfaf76ef618ecdd9",
      "content": "--- a/pipeline/normalize.py\n+++ b/pipeline/normalize.py\n@@ -1,3 +1,15 @@\n+class UnitContractError(ValueError):\n+    \"\"\"Raised when an experimental value violates the declared unit contract.\"\"\"\n+\n+\n def normalize_tg(value: float, unit: str) -> float:\n-    # v1 trusted the destination column label and silently copied mixed units.\n-    return float(value)\n+    \"\"\"Normalize Tg into degC or reject an unknown unit.\"\"\"\n+\n+    normalized = unit.strip()\n+    if normalized == \"degC\":\n+        return float(value)\n+    if normalized == \"K\":\n+        return round(float(value) - 273.15, 6)\n+    raise UnitContractError(\n+        f\"unsupported Tg unit {unit!r}; expected 'degC' or 'K'\"\n+    )\n",
      "content_sha256": "c3918e50fc17eef41c84e823fa9fbb195e8f783a35e18e208705321351137013",
      "description": "Fail-closed K-to-degC scientific-unit normalization patch.",
      "evidence_ids": [
        "field-impact:bb47513135e033a4",
        "upstream-lineage:94ee77e7deccd454",
        "unit-firmware-contract:711d085fe8869ed0",
