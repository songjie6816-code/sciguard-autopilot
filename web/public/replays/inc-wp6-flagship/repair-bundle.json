        "unit-firmware-contract:711d085fe8869ed0",
        "datahub-live-receipt:fa0b942ca360c2ce"
      ],
      "kind": "SCIENTIFIC_REGRESSION_TEST",
      "path": "tests/test_scientific_decision.py"
    },
    {
      "artifact_id": "repair-artifact:0e8162dd175f7c69",
      "content": "import hashlib\nimport json\n\n\ndef _artifact_sha256(rows: list[dict[str, float | str]]) -> str:\n    payload = json.dumps(rows, sort_keys=True, separators=(\",\", \":\")).encode()\n    return hashlib.sha256(payload).hexdigest()\n\n\ndef test_molecular_weight_branch_is_bitwise_unchanged() -> None:\n    records = [\n        {\"sample_id\": \"P-204\", \"mn_g_mol\": 55000.0, \"mw_g_mol\": 99000.0},\n        {\"sample_id\": \"P-205\", \"mn_g_mol\": 48000.0, \"mw_g_mol\": 84000.0},\n    ]\n    trusted_artifact_sha256 = _artifact_sha256(records)\n    repaired_artifact_sha256 = _artifact_sha256(records)\n\n    assert repaired_artifact_sha256 == trusted_artifact_sha256\n    publish_exit_code = 0\n    assert publish_exit_code == 0\n",
