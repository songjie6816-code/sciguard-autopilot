{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sciguard-live-sandbox",
  "main": "worker/live-sandbox.ts",
  "compatibility_date": "2026-05-22",
  "durable_objects": {
    "bindings": [
      {
        "name": "LIVE_SANDBOX",
        "class_name": "LiveSandbox"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["LiveSandbox"]
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "SCIGUARD_ALLOWED_ORIGINS": "https://sciguard-autopilot-demo.pages.dev,http://localhost:4173,http://127.0.0.1:4173"
  }
}
